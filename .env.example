# BalVoice website configuration — PUBLIC values only.
# Copy to .env and fill in, then run: python3 build.py
# Never put the Supabase service-role key or the BMS API key here; those live
# only in Supabase Edge Function secrets (see docs/AUTH-SUPABASE.md).

# Your production address (used for canonical links, sitemap, and auth redirects)
SITE_URL=https://www.example.com

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Optional but strongly recommended: Cloudflare Turnstile site key.
# Protects sign-up and SMS code requests from bots (prevents SMS fraud costs).
# Enable the same provider under Supabase → Authentication → Attack Protection.
TURNSTILE_SITE_KEY=

# Countries allowed for phone sign-in (ISO codes, comma separated).
# Must match ALLOWED_PHONE_PREFIXES in the send-sms Edge Function.
ALLOWED_PHONE_COUNTRIES=GH
